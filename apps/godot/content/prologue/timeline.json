    "SC06_Cart_Crash_Rain": {
      "objective": "先看清现场。左是车下孩子，中间是湿简，右是失散的人群；按住 E 才会锁定行动。",
      "choice_pressure": {
        "initial_title": "雨夜翻车现场",
        "initial_detail": "左侧火把下是车辕压住的孩子；中间泥水里有正在散墨的湿简；右侧棚下有人喊错亲属。移动只让你看见。",
        "thresholds": [
          {
            "seconds": 3.0,
            "text": "你刚看清三处压力。这里不会因为你还在辨认方向而暗中判败。"
          },
          {
            "seconds": 10.0,
            "text": "孩子哭声变轻，湿简墨迹更散，棚下有人开始喊错名字。"
          }
        ],
        "directions": {
          "rescue_child": {
            "title": "左侧：车辕下的孩子",
            "detail": "禾安用肩顶住木梁，脚在泥里滑了一下又站稳。孩子哭声断断续续。",
            "costs": [
              "雨水仍在冲刷湿简",
              "棚下仍有人喊错名字"
            ]
          },
          "save_records": {
            "title": "中间：泥水里的湿简",
            "detail": "韩宁挣着要扑过去，几片木牍在水里浮沉，墨线正在散开。",
            "costs": [
              "车下孩子的哭声断了一下",
              "人群仍未完成互认"
            ]
          },
          "mutual_recognition": {
            "title": "右侧：失散人群",
            "detail": "柳娘抱着孩子喊名，棚下有人把别家的孩子攥得太紧。",
            "costs": [
              "雨水还在泡湿简",
              "车下孩子仍被压着"
            ]
          }
        }
      },

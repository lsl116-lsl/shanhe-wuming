{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shanhe://schema/memory",
  "title": "山河无名记忆碎片",
  "type": "object",
  "required": ["schemaVersion", "memories"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "act",
          "type",
          "revealLevel",
          "mandatory",
          "perceivedContent",
          "realityEffect",
          "linkedCauses",
          "repeatLine"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^MEM-CH[0-9]{2}-[0-9]{3}$" },
          "title": { "type": "string" },
          "act": { "type": "string", "pattern": "^ACT[0-9]{2}$" },
          "type": {
            "enum": ["dream", "emotion", "resonance", "misrecognition", "prompt"]
          },
          "revealLevel": { "enum": ["M0", "M1", "M2", "M3", "M4"] },
          "mandatory": { "type": "boolean" },
          "perceivedContent": { "type": "string" },
          "realityEffect": { "type": "string" },
          "linkedCauses": {
            "type": "array",
            "items": { "type": "string" }
          },
          "repeatLine": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

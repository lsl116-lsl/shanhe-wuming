{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shanhe://schema/chapter",
  "title": "山河无名章节清单",
  "type": "object",
  "required": [
    "schemaVersion",
    "contentVersion",
    "runtimeVersion",
    "id",
    "title",
    "sampleTitle",
    "sceneFiles",
    "characterFile",
    "causeFile",
    "recordFile",
    "memoryFile"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "contentVersion": { "type": "string" },
    "runtimeVersion": { "type": "string" },
    "id": { "type": "string", "pattern": "^CH[0-9]{2}$" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "sampleTitle": { "type": "string" },
    "description": { "type": "string" },
    "sceneFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "characterFile": { "type": "string" },
    "causeFile": { "type": "string" },
    "recordFile": { "type": "string" },
    "memoryFile": { "type": "string" }
  },
  "additionalProperties": false
}
